{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "AWS_REGION": "us-east-1",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "deny": [
      "Read(**/*.env*)",
      "Read(**/*.env)",
      "Read(**/.env.local)",
      "Read(**/secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/Library/Keychains/**)",
      "Bash(**/bin/deploy*)",
      "Bash(**/bin/decrypt-keys*)",
      "Bash(aws-vault *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": []
  },
  "statusLine": {
    "type": "command",
    "command": "~/src/statusline/statusline"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat /Users/morganwigmanich/.claude/hooks/reply-style.txt",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/morganwigmanich/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/morganwigmanich/.claude/hooks/block-nested-worktree.sh'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "agent-skills@addy-agent-skills": true,
    "i-have-adhd@i-have-adhd": true,
    "code@wistia-skills": true
  },
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "wistia-skills": {
      "source": {
        "source": "github",
        "repo": "wistia/skills"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": [
        "."
      ],
      "denyWrite": [
        "/"
      ],
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        "."
      ]
    }
  },
  "feedbackDrafts": "off",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "autoCompactWindow": 200000,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "model": "opus"
}
