{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "AWS_REGION": "us-east-1",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "deny": [
      "Read(**/*.env*)",
      "Read(**/*.env)",
      "Read(**/.env.local)",
      "Read(**/secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/Library/Keychains/**)",
      "Bash(**/bin/deploy*)",
      "Bash(**/bin/decrypt-keys*)",
      "Bash(aws-vault *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/Users/morganwigmanich/wistia/wizard"
    ]
  },
  "model": "claude-fable-5-1[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat /Users/morganwigmanich/.claude/hooks/reply-style.txt",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/morganwigmanich/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/src/statusline/statusline"
  },
  "enabledPlugins": {
    "agent-skills@addy-agent-skills": true,
    "codex@openai-codex": true,
    "i-have-adhd@i-have-adhd": true,
    "superpowers@claude-plugins-official": true,
    "worktrunk@worktrunk": true,
    "code@wistia-skills": true
  },
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    },
    "unifi-plugins": {
      "source": {
        "source": "github",
        "repo": "sirkirby/unifi-mcp"
      }
    },
    "wistia-skills": {
      "source": {
        "source": "github",
        "repo": "wistia/skills"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": [
        "."
      ],
      "denyWrite": [
        "/"
      ],
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        "."
      ]
    }
  },
  "feedbackDrafts": "off",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto"
}
